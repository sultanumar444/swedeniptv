0, "h": 534}]}]}, {"t": "section", "id": "defa342", "cls": ["elementor-top-section", "elementor-section-boxed", "elementor-section-height-default", "elementor-section-height-default"], "gap": "elementor-column-gap-default", "overlay": false, "children": [{"t": "column", "id": "254a603", "cls": ["elementor-col-100", "elementor-top-column"], "populated": true, "overlay": false, "children": [{"t": "text-editor", "id": "5b882a8", "cls": [], "html": "Grunderna"}, {"t": "heading", "id": "60927f3", "cls": [], "tag": "h2", "size": "elementor-size-default", "html": "Vad är en M3U Playlist?"}, {"t": "text-editor", "id": "4464097", "cls": [], "html": "<p>M3U är ett textbaserat playlist-format som används för att strukturera en lista med medieposter. I IPTV-sammanhang kan listan innehålla information som kanalnamn, grupper, metadata och referenser till streamad media.</p>"}, {"t": "section", "id": "129c630", "cls": ["elementor-inner-section", "elementor-section-boxed", "elementor-section-height-default", "elementor-section-height-default"], "gap": "elementor-column-gap-default", "overlay": false, "children": [{"t": "column", "id": "d6a1a0a", "cls": ["elementor-col-33", "elementor-inner-column"], "populated": true, "overlay": false, "children": [{"t": "heading", "id": "a0814b4", "cls": [], "tag": "h3", "size": "elementor-size-default", "html": "En playlist"}, {"t": "text-editor", "id": "391e524", "cls": [], "html": "<article><p>M3U organiserar information om flera streamposter i en strukturerad lista.</p></article><article></article>"}]}, {"t": "column", "id": "b3cb6ea", "cls": ["elementor-col-33", "elementor-inner-column"], "populated": true, "overlay": false, "children": [{"t": "heading", "id": "94835c4", "cls": [], "tag": "h3", "size": "elementor-size-default", "html": "Inte själva innehållet"}, {"t": "text-editor", "id": "28287a9", "cls": [], "html": "<article><article><p>En M3U-fil är inte automatiskt en TV-tjänst eller videofil. Den beskriver var och hur en kompatibel player kan hitta innehåll.</p></article><article></article></article><article></article>"}]}, {"t": "column", "id": "0afc747", "cls": ["elementor-col-33", "elementor-inner-column"], "populated": true, "overlay": false, "children": [{"t": "heading", "id": "dedc552", "cls": [], "tag": "h3", "size": "elementor-size-default", "html": "Behöver en player"}, {"t": "text-editor", "id": "14c8187", "cls": [], "html": "<article><section><article><p>En kompatibel IPTV- eller mediaspelare läser playlisten och presenterar posterna på din enhet.</p></article></section></article><article></article>"}]}]}]}]}, {"t": "section", "id": "5186cc8", "cls": ["elementor-top-section", "elementor-section-boxed", "elementor-section-height-default", "elementor-section-height-default"], "gap": "elementor-column-gap-default", "overlay": false, "children": [{"t": "column", "id": "0fea0cb", "cls": ["elementor-col-50", "elementor-top-column"], "populated": true, "overlay": false, "children": [{"t": "text-editor", "id": "f6fbe04", "cls": [], "html": "Så fungerar det"}, {"t": "heading", "id": "85274bb", "cls": [], "tag": "h2", "size": "elementor-size-default", "html": "Från M3U till streaming"}, {"t": "text-editor", "id": "385517f", "cls": [], "html": "<p>Flödet är enkelt: playlisten läses av en kompatibel player, informationen tolkas och tillgängliga poster visas i ett användargränssnitt.</p>"}]}, {"t": "column", "id": "c49413e", "cls": ["elementor-col-50", "elementor-top-column"], "populated": true, "overlay": false, "children": [{"t": "section", "id": "992145b", "cls": ["elementor-inner-section", "elementor-section-boxed", "elementor-section-height-default", "elementor-section-height-default"], "gap": "elementor-column-gap-default", "overlay": false, "children": [{"t": "column", "id": "c3c7599", "cls": ["elementor-col-50", "elementor-inner-column"], "populated": true, "overlay": false, "children": [{"t": "heading", "id": "c5e7cf1", "cls": [], "tag": "h3", "size": "elementor-size-default", "html": "1. M3U"}, {"t": "text-editor", "id": "e2da63e", "cls": [], "html": "<article><p>Playlist med strukturerad information.</p></article><article></article>"}]}, {"t": "column", "id": "5664376", "cls": ["elementor-col-50", "elementor-inner-column"], "populated": true, "overlay": false, "children": [{"t": "heading", "id": "c104d92", "cls": [], "tag": "h3", "size": "elementor-size-default", "html": "2. Player"}, {"t": "text-editor", "id": "2f815d2", "cls": [], "html": "<article><article><p>Appen läser och tolkar formatet.</p></article><article></article></article><article></article>"}]}]}, {"t": "section", "id": "f7ad7db", "cls": ["elementor-inner-section", "elementor-section-boxed", "elementor-section-height-default", "elementor-section-height-default"], "gap": "elementor-column-gap-default", "overlay": false, "children": [{"t": "column", "id": "28aebb7", "cls": ["elementor-col-50", "elementor-inner-column"], "populated": true, "overlay": false, "children": [{"t": "heading", "id": "28359a7", "cls": [], "tag": "h3", "size": "elementor-size-default", "html": "3. Kanalista"}, {"t": "text-editor", "id": "d6dd93f", "cls": [], "html": "<article><article><p>Poster sorteras efter tillgänglig metadata.</p></article><article></article></article><article></article>"}]}, {"t": "column", "id": "ed0389c", "cls": ["elementor-col-50", "elementor-inner-column"], "populated": true, "overlay": false, "children": [{"t": "heading", "id": "122f3ba", "cls": [], "tag": "h3", "size": "elementor-size-default", "html": "4. Streaming"}, {"t": "text-editor", "id": "88e297a", "cls": [], "html": "<article><section><article><p>Kompatibla streamreferenser kan spelas upp.</p></article></section></article><article></article>"}]}]}]}]}, {"t": "section", "id": "a4531e1", "cls": ["elementor-top-section", "elementor-section-boxed", "elementor-section-height-default", "elementor-section-height-default"], "gap": "elementor-column-gap-default", "overlay": false, "children": [{"t": "column", "id": "1ba3874", "cls": ["elementor-col-100", "elementor-top-column"], "populated": true, "overlay": false, "children": [{"t": "text-editor", "id": "631a457", "cls": [], "html": "Struktur"}, {"t": "heading", "id": "aa9858e", "cls": [], "tag": "h2", "size": "elementor-size-default", "html": "Hur ser en M3U-lista ut?"}, {"t": "text-editor", "id": "00a63bf", "cls": [], "html": "<p>En M3U-playlist kan innehålla direktiv och metadata följt av en streamreferens. Exemplet nedan är endast en strukturell illustration och är inte en fungerande streamadress.</p>"}]}]}, {"t": "section", "id": "86970e4", "cls": ["elementor-top-section", "elementor-section-boxed", "elementor-section-height-default", "elementor-section-height-default"], "gap": "elementor-column-gap-default", "overlay": false, "children": [{"t": "column", "id": "e77dec4", "cls": ["elementor-col-100", "elementor-top-column"], "populated": true, "overlay": false, "children": [{"t": "text-editor", "id": "80b07fa", "cls": [], "html": "Kom igång"}, {"t": "heading", "id": "75f0b23", "cls": [], "tag": "h2", "size": "elementor-size-default", "html": "Så använder du M3U på en kompatibel enhet"}, {"t": "section", "id": "b3ee57c", "cls": ["elementor-inner-section", "elementor-section-boxed", "elementor-section-height-default", "elementor-section-height-default"], "gap": "elementor-column-gap-default", "overlay": false, "children": [{"t": "column", "id": "7204517", "cls": ["elementor-col-25", "elementor-inner-column"], "populated": true, "overlay": false, "children": [{"t": "text-editor", "id": "886fdf4", "cls": [], "html": "STEG 01"}, {"t": "heading", "id": "506786b", "cls": [], "tag": "h2", "size": "elementor-size-default", "html": "Välj en player"}, {"t": "text-editor", "id": "bee51ac", "cls": [], "html": "<p>Använd en kompatibel app eller mediaspelare.</p>"}]}, {"t": "column", "id": "c83c8dc", "cls": ["elementor-col-25", "elementor-inner-column"], "populated": true, "overlay": false, "children": [{"t": "text-editor", "id": "837fc63", "cls": [], "ht